# Copy this file to .env and edit before first run.

# Random long random string - used to sign login sessions. Change this!
SECRET_KEY=change-this-to-a-long-random-string

# Set to true only if this app sits behind HTTPS (e.g. a reverse proxy with a
# certificate). Leave false for plain-HTTP homelab access.
SESSION_HTTPS_ONLY=false

# --- Automatic backups ---
# Backs up the database + receipts on a timer, keeps the most recent N copies.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=30
# How long to wait after startup before the first automatic backup runs.
BACKUP_STARTUP_DELAY_SECONDS=60
# Max size accepted when restoring from an uploaded (offsite) backup file.
MAX_RESTORE_UPLOAD_MB=100

# Currency symbol used on vouchers and reports
CURRENCY_SYMBOL=SAR

# VAT percentage applied to line items marked "VAT-able" (e.g. 15 for KSA).
# Change this if your VAT rate changes - existing vouchers keep the rate
# that was in effect when they were recorded, so past vouchers are never
# retroactively altered.
VAT_RATE=15.0

# Company name shown on vouchers
COMPANY_NAME=Dolal and Son Company Limited

# Company address shown under the name on vouchers, reports, and the login
# page. Leave blank to omit it entirely.
COMPANY_ADDRESS=LHPA9339, 381 Mulhim Street, Malham

# Default admin account created on first run (change password after first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- automatic backups ---
# Backs up the database + receipts to data/backups/ on a schedule, plus lets a
# manager back up on demand and restore from any past backup in the UI.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# how many backups to keep before the oldest are auto-deleted
BACKUP_RETENTION_COUNT=30

# --- optional: Cloudflare Tunnel ---
# Only used if you run the optional cloudflared service
# (docker compose --profile cloudflare up -d). Leave blank if you're not
# using this. Get a token by creating a tunnel at
# https://one.dash.cloudflare.com/ -> Networks -> Tunnels -> Create a tunnel
# (choose "Cloudflared" as the connector) - the setup page gives you a
# command containing this token; copy just the token value here.
# See the README section on this for the full walkthrough, including
# adding the tunnel's hostname under Settings -> Network in the app.
CLOUDFLARE_TUNNEL_TOKEN=
